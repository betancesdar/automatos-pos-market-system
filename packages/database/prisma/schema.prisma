// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id             String   @id @default(uuid())
  name           String
  rnc            String   @unique
  phone          String?
  address        String?
  isActive       Boolean  @default(true)
  plan           String   @default("BASIC")
  planCode       String?
  planRef        Plan?    @relation(fields: [planCode], references: [code])
  expiresAt      DateTime
  // "DIRECT" = POS clásico (cobra quien factura) | "BILLER_CASHIER" = facturadores + caja central
  workflowMode   String   @default("DIRECT")
  // Atomic per-tenant invoice counter (replaces count()+1)
  invoiceCounter Int      @default(0)
  // Atomic per-tenant quote (cotización) counter
  quoteCounter   Int      @default(0)
  // Atomic per-tenant promissory note (pagaré) counter
  promissoryCounter Int   @default(0)
  // Thermal receipt configuration
  receiptLogoUrl String?
  commercialName String?
  receiptFooter  String?
  paperSize      String   @default("80mm")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  users             User[]
  categories        Category[]
  products          Product[]
  sales             Sale[]
  ncfSequences      NCFSequence[]
  cashDrawerLogs    CashDrawerLog[]
  cashSessions      CashSession[]
  cashMovements     CashMovement[]
  orders            Order[]
  orderCounters     OrderDailyCounter[]
  ecfConfig         TenantEcfConfig?
  ecfSubmissions    EcfSubmission[]
  purchases         Purchase[]
  reconciliations   CashReconciliation[]
  accountingPeriods AccountingPeriod[]
  accountingEntries AccountingEntry[]
  customRoles       CustomRole[]
  customers         Customer[]
  quotes            Quote[]
  zones             Zone[]
}

model User {
  id        String   @id @default(uuid())
  name      String
  username  String   @unique
  email     String?  @unique
  password  String
  // Base/system role — kept as the RBAC baseline. Effective permissions =
  // ROLE_DEFAULTS[role] ∪ customRole.permissionCodes (see permissions.catalog.ts).
  role      Role     @default(CASHIER)
  // Optional per-tenant custom role that adds/overrides granular permissions.
  customRoleId String?
  customRole   CustomRole? @relation(fields: [customRoleId], references: [id])
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  cashSessions  CashSession[]
  createdOrders Order[]       @relation("OrderCreator")

  @@unique([tenantId, username])
}

enum Role {
  SUPER_ADMIN
  ADMIN
  CASHIER
  BILLER
  ACCOUNTANT
}

// Rol personalizado por comercio (RBAC). El catálogo de permisos vive en código
// (apps/api/src/common/permissions.catalog.ts) como fuente única de verdad; aquí
// solo se guardan los códigos seleccionados para este rol.
model CustomRole {
  id              String   @id @default(uuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  permissionCodes String[] // referencia a Permission.code del catálogo en código
  isSystem        Boolean  @default(false) // roles sembrados equivalentes al enum base
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  users           User[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Category {
  id          String    @id @default(uuid())
  name        String
  slug        String
  description String?
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products    Product[]
  createdAt   DateTime  @default(now())

  @@unique([slug, tenantId])
}

model Product {
  id            String      @id @default(uuid())
  barcode       String?
  sku           String?
  name          String
  description   String?
  type          ProductType @default(PRODUCT)
  hasVariants   Boolean     @default(false)
  uom           String?     @default("Unidad")
  basePrice     Float       @default(0)
  taxPercentage Float       @default(18)
  taxType       String      @default("ITBIS")
  price         Float // Final (tax-inclusive) selling price = basePrice * (1 + taxPercentage/100)
  cost          Float
  stock         Int         @default(0)
  quantityMin   Float       @default(0)
  quantityMax   Float?      @default(0)
  imageUrl      String?
  categoryId    String?
  category      Category?   @relation(fields: [categoryId], references: [id])
  zoneId        String?
  zone          Zone?       @relation(fields: [zoneId], references: [id])
  tenantId      String
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  saleItems     SaleItem[]
  orderItems    OrderItem[]

  @@unique([barcode, tenantId])
  @@unique([sku, tenantId])
}

enum ProductType {
  PRODUCT
  SERVICE
  COMBO
}

// Zona/ubicación organizativa del inventario (Fase 5). El stock es único por
// producto; la zona agrupa y filtra (pasillo, área, bodega lógica).
model Zone {
  id          String    @id @default(uuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  products    Product[]

  @@unique([tenantId, name])
}

model NCFSequence {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type      NcfType
  prefix    String
  nextValue Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, type])
}

model Sale {
  id            String         @id @default(uuid())
  invoiceNumber String?
  // Client-generated UUID for sales made while offline. Used by /sales/sync
  // to guarantee idempotency (never double-charge/double-deduct stock) when
  // the POS re-submits its pending offline queue.
  offlineId     String?        @unique
  total         Float
  subtotal      Float          @default(0)
  cashReceived  Float?
  changeDue     Float?
  totalReceived Float          @default(0)
  totalChange   Float          @default(0)
  ncf           String?
  ncfType       NcfType        @default(VENTA_RAPIDA)
  clientRnc     String?
  clientName    String?
  itbis         Float          @default(0)
  applyItbis    Boolean        @default(false)
  paymentMethod PaymentMethod  @default(CASH)
  status        String         @default("COMPLETED")
  voidedAt      DateTime?
  voidReason    String?
  tenantId      String
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cashSessionId String?
  cashSession   CashSession?   @relation(fields: [cashSessionId], references: [id])
  // e-CF (facturación electrónica) tracking — null when tenant has e-CF disabled
  ecfStatus     String?
  ecfTrackId    String?
  createdAt     DateTime       @default(now())
  items         SaleItem[]
  order         Order?
  ecfSubmission EcfSubmission?
  creditSale    CreditSale?

  @@unique([invoiceNumber, tenantId])
  @@unique([tenantId, ncf])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
}

model CashSession {
  id                     String              @id @default(uuid())
  tenantId               String
  tenant                 Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId                 String
  user                   User                @relation(fields: [userId], references: [id])
  openedAt               DateTime            @default(now())
  closedAt               DateTime?
  openingBalance         Float
  expectedClosingBalance Float?
  actualClosingBalance   Float?
  status                 String              @default("OPEN")
  createdAt              DateTime            @default(now())
  sales                  Sale[]
  movements              CashMovement[]
  reconciliation         CashReconciliation?

  @@index([tenantId, userId, status])
}

model CashMovement {
  id            String      @id @default(uuid())
  cashSessionId String
  cashSession   CashSession @relation(fields: [cashSessionId], references: [id])
  tenantId      String
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type          String // "INFLOW" | "OUTFLOW"
  amount        Float
  reason        String
  createdAt     DateTime    @default(now())

  @@index([cashSessionId])
  @@index([tenantId, createdAt])
}

model SaleItem {
  id        String  @id @default(uuid())
  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Float
  price     Float
  cost      Float
  isLoose   Boolean @default(false)
}

model CashDrawerLog {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  shiftDate    DateTime @default(now())
  expectedCash Float
  countedCash  Float
  discrepancy  Float
  notes        String?
  createdAt    DateTime @default(now())
}

enum NcfType {
  SIN_NCF
  VENTA_RAPIDA
  CONSUMIDOR_FINAL
  CREDITO_FISCAL
  REGISTRO_UNICO_INGRESO
  GUBERNAMENTAL
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  CREDIT
}

// ─────────────────────────────────────────────────────────────────────────────
// Flujo Facturador/Caja: pedidos creados por facturadores y cobrados en caja
// ─────────────────────────────────────────────────────────────────────────────

enum OrderStatus {
  PENDING
  COMPLETED
  CANCELLED
  EXPIRED
}

model Order {
  id            String      @id @default(uuid())
  tenantId      String
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Short daily code the biller tells the client ("#042"); resets per business day
  dailyCode     Int
  businessDate  DateTime    @db.Date
  status        OrderStatus @default(PENDING)
  creatorUserId String
  creator       User        @relation("OrderCreator", fields: [creatorUserId], references: [id])
  clientName    String?
  clientRnc     String?
  ncfType       NcfType     @default(VENTA_RAPIDA)
  notes         String?
  // Informational snapshot at billing time; cashier checkout recomputes from items
  subtotal      Float       @default(0)
  saleId        String?     @unique
  sale          Sale?       @relation(fields: [saleId], references: [id])
  completedById String?
  cancelReason  String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  items         OrderItem[]

  @@unique([tenantId, businessDate, dailyCode])
  @@index([tenantId, status, createdAt])
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Float
  unitPrice Float
  isLoose   Boolean @default(false)
}

// Atomic per-tenant/per-day counter for Order.dailyCode
model OrderDailyCounter {
  tenantId     String
  businessDate DateTime @db.Date
  nextValue    Int      @default(1)
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, businessDate])
}

// ─────────────────────────────────────────────────────────────────────────────
// Facturación electrónica e-CF (Pronesoft)
// ─────────────────────────────────────────────────────────────────────────────

// Credencial de la App MATRIZ de Pronesoft (una sola para toda la plataforma).
// La maneja el SuperAdmin; opera por todas las empresas asociadas vía x-tenant-id.
model PlatformEcfConfig {
  id                    String   @id @default("default")
  enabled               Boolean  @default(false)
  activeEnvironment     String   @default("sandbox") // "sandbox" | "prod"
  sandboxClientId       String?
  sandboxClientSecretEnc String? // AES-256-GCM (ECF_SECRET_KEY)
  prodClientId          String?
  prodClientSecretEnc   String?
  updatedAt             DateTime @updatedAt
}

// Vínculo e-CF de cada comercio con su empresa asociada en la cuenta matriz.
// Ya NO guarda credenciales: usa la credencial matriz + x-tenant-id.
model TenantEcfConfig {
  tenantId           String   @id
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enabled            Boolean  @default(false)
  // id (UUID) de la empresa asociada en Pronesoft → se envía como header x-tenant-id
  pronesoftBusinessId String?
  pronesoftRnc       String?
  environment        String   @default("sandbox") // informativo (el ambiente lo fija la matriz)
  // Deprecados: credenciales por comercio (ya no se usan; el ambiente es de la matriz)
  clientId           String?
  clientSecretEnc    String?
  updatedAt          DateTime @updatedAt
}

model EcfSubmission {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  saleId      String   @unique
  sale        Sale     @relation(fields: [saleId], references: [id])
  // QUEUED → PROCESSING → SENT (registrado en Pronesoft) → legalStatus (DGII) | FAILED
  status      String   @default("QUEUED")
  attempts    Int      @default(0)
  nextRetryAt DateTime @default(now())
  // id del documento en Pronesoft (para consultar estado) y e-NCF asignado (E31..)
  documentId  String?
  encf        String?
  trackId     String?  // trackId de la DGII (llega al consultar estado)
  legalStatus String?  // ACCEPTED | ACCEPTED_WITH_OBSERVATIONS | REJECTED | ERROR
  lastError   String?
  payload     Json?
  response    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, nextRetryAt])
  @@index([tenantId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Planes de la plataforma (SuperAdmin)
// ─────────────────────────────────────────────────────────────────────────────

model Plan {
  code         String   @id // "BASIC", "PREMIUM", "ENTERPRISE"
  name         String
  monthlyPrice Float    @default(0)
  maxUsers     Int      @default(5)
  maxProducts  Int      @default(1000)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  tenants      Tenant[]
}

model AuditLog {
  id             String   @id @default(uuid())
  actorUserId    String
  actorUsername  String
  action         String // "TENANT_SUSPEND", "IMPERSONATE", "PERIOD_APPROVE", ...
  targetTenantId String?
  metadata       Json?
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@index([targetTenantId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Contabilidad RD: conciliaciones, compras (606) y cierres mensuales
// ─────────────────────────────────────────────────────────────────────────────

// Compras y gastos con NCF de proveedor — alimenta el Formato 606 de DGII
model Purchase {
  id              String        @id @default(uuid())
  tenantId        String
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplierRnc     String
  supplierName    String
  ncf             String
  ncfType         String        @default("B01")
  // Código de clasificación de gasto DGII 01-11 (606)
  expenseCategory String
  date            DateTime
  subtotal        Float
  itbis           Float         @default(0)
  itbisRetenido   Float         @default(0)
  isrRetenido     Float         @default(0)
  total           Float
  paymentMethod   PaymentMethod @default(CASH)
  notes           String?
  createdById     String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([tenantId, date])
}

// Conciliación de caja: creada automáticamente al cerrar cada CashSession
model CashReconciliation {
  id            String      @id @default(uuid())
  tenantId      String
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cashSessionId String      @unique
  cashSession   CashSession @relation(fields: [cashSessionId], references: [id])
  expectedCash  Float
  countedCash   Float
  difference    Float
  status        String      @default("PENDING_REVIEW") // PENDING_REVIEW | APPROVED | OBSERVED
  reviewedById  String?
  reviewNotes   String?
  reviewedAt    DateTime?
  createdAt     DateTime    @default(now())

  @@index([tenantId, status, createdAt])
}

// Asiento/movimiento contable manual (Fase 6): ingresos, gastos o ajustes que
// no provienen de ventas ni compras (ej. gasto de luz sin NCF, ajuste de caja).
enum AccountingEntryType {
  INCOME
  EXPENSE
  ADJUSTMENT
}

model AccountingEntry {
  id          String              @id @default(uuid())
  tenantId    String
  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  date        DateTime
  type        AccountingEntryType
  category    String
  amount      Decimal             @db.Decimal(14, 2)
  description String?
  createdById String
  createdAt   DateTime            @default(now())

  @@index([tenantId, date])
}

// Cierre contable mensual con flujo verificar → aprobar → presentar en DGII
model AccountingPeriod {
  id           String    @id @default(uuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  year         Int
  month        Int
  status       String    @default("OPEN") // OPEN | CLOSED | APPROVED
  // Frozen totals at close: ventas, ITBIS cobrado, compras, ITBIS pagado, anulaciones, diferencias de caja
  snapshot     Json?
  closedById   String?
  closedAt     DateTime?
  approvedById String?
  approvedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([tenantId, year, month])
}

// ─────────────────────────────────────────────────────────────────────────────
// Clientes y Cotizaciones (Fase 3). Dinero nuevo en Decimal (ver prisma/money.md).
// ─────────────────────────────────────────────────────────────────────────────

enum CustomerDocType {
  RNC
  CEDULA
  NONE
}

model Customer {
  id          String          @id @default(uuid())
  tenantId    String
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  docType     CustomerDocType @default(NONE)
  docNumber   String?
  phone       String?
  email       String?
  address     String?
  creditLimit Decimal         @default(0) @db.Decimal(14, 2)
  balance     Decimal         @default(0) @db.Decimal(14, 2) // saldo por cobrar (Fase 4)
  isActive    Boolean         @default(true)
  notes       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  quotes      Quote[]
  creditSales CreditSale[]

  @@index([tenantId, name])
  @@index([tenantId, docNumber])
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  CONVERTED
  EXPIRED
  CANCELLED
}

model Quote {
  id                String      @id @default(uuid())
  tenantId          String
  tenant            Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  number            Int // secuencia propia por tenant (Tenant.quoteCounter)
  customerId        String?
  customer          Customer?   @relation(fields: [customerId], references: [id])
  clientNameSnapshot String?    // nombre en el momento (si no hay Customer)
  status            QuoteStatus @default(DRAFT)
  validUntil        DateTime?
  subtotal          Decimal     @default(0) @db.Decimal(14, 2)
  itbis             Decimal     @default(0) @db.Decimal(14, 2)
  total             Decimal     @default(0) @db.Decimal(14, 2)
  notes             String?
  createdById       String
  convertedSaleId   String?
  convertedOrderId  String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  items             QuoteItem[]

  @@unique([tenantId, number])
  @@index([tenantId, status, createdAt])
}

model QuoteItem {
  id        String  @id @default(uuid())
  quoteId   String
  quote     Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productId String
  productName String // snapshot para que la cotización no cambie si cambia el producto
  quantity  Float
  unitPrice Decimal @db.Decimal(14, 2)
  isLoose   Boolean @default(false)
}

// ─────────────────────────────────────────────────────────────────────────────
// Crédito / Cuentas por cobrar (Fase 4): factura a crédito con cuotas, mora
// configurable, abonos y pagaré notarial. Dinero en Decimal.
// ─────────────────────────────────────────────────────────────────────────────

enum CreditFrequency {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  CUSTOM
}

enum CreditStatus {
  OPEN
  PAID
  OVERDUE
  CANCELLED
}

enum InstallmentStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
}

model CreditSale {
  id               String          @id @default(uuid())
  tenantId         String
  saleId           String          @unique
  sale             Sale            @relation(fields: [saleId], references: [id])
  customerId       String
  customer         Customer        @relation(fields: [customerId], references: [id])
  principal        Decimal         @db.Decimal(14, 2) // total de la venta
  downPayment      Decimal         @default(0) @db.Decimal(14, 2) // inicial
  financedAmount   Decimal         @db.Decimal(14, 2) // principal - inicial
  installmentsCount Int
  frequency        CreditFrequency @default(MONTHLY)
  // Intervalo en días cuando frequency = CUSTOM (ej. cada 10 días)
  intervalDays     Int?
  firstDueDate     DateTime
  lateFeePercent   Decimal         @default(0) @db.Decimal(5, 2) // recargo por mora (%)
  balance          Decimal         @db.Decimal(14, 2) // saldo pendiente
  status           CreditStatus    @default(OPEN)
  createdById      String
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  installments     Installment[]
  payments         CreditPayment[]
  promissoryNote   PromissoryNote?

  @@index([tenantId, status])
  @@index([customerId])
}

model Installment {
  id           String            @id @default(uuid())
  creditSaleId String
  creditSale   CreditSale        @relation(fields: [creditSaleId], references: [id], onDelete: Cascade)
  number       Int
  dueDate      DateTime
  amount       Decimal           @db.Decimal(14, 2)
  paidAmount   Decimal           @default(0) @db.Decimal(14, 2)
  status       InstallmentStatus @default(PENDING)

  @@index([creditSaleId])
}

model CreditPayment {
  id           String        @id @default(uuid())
  tenantId     String
  creditSaleId String
  creditSale   CreditSale    @relation(fields: [creditSaleId], references: [id], onDelete: Cascade)
  amount       Decimal       @db.Decimal(14, 2)
  method       PaymentMethod @default(CASH)
  isDownPayment Boolean      @default(false)
  receivedById String
  cashSessionId String?
  note         String?
  createdAt    DateTime      @default(now())

  @@index([tenantId, createdAt])
  @@index([creditSaleId])
}

model PromissoryNote {
  id             String     @id @default(uuid())
  creditSaleId   String     @unique
  creditSale     CreditSale @relation(fields: [creditSaleId], references: [id], onDelete: Cascade)
  number         String // ej. PG-2026-00001
  debtorSnapshot Json // nombre, documento, dirección, teléfono al momento
  amount         Decimal    @db.Decimal(14, 2)
  amountInWords  String
  legalText      String // texto del pagaré generado
  signedAt       DateTime?
  notaryInfo     String?
  createdAt      DateTime   @default(now())
}
