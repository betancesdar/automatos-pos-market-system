# ─────────────────────────────────────────────────────────────────────────────
# MiniMarket OS — Production Environment
# Droplet IP: 192.241.248.187 (DigitalOcean)
# Domains: pos.automatostech.com (front) / master.automatostech.com (API) — Cloudflare
# Copy to .env on your server: cp .env.production .env
# ─────────────────────────────────────────────────────────────────────────────

# --- DATABASE & REDIS SECRETS ---
POSTGRES_USER=minimarket
POSTGRES_PASSWORD=AutomatosSecurePass2026!
POSTGRES_DB=minimarket_os
REDIS_PASSWORD=AutomatosRedisPass2026!

# --- SECURITY TOKENS ---
# ⚠️ ROTA estos valores en el servidor (están versionados en git). Genera nuevos:
#    openssl rand -hex 32
JWT_SECRET=8f9a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a6b7c8d9e0f1a
COOKIE_SECRET=1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a6b7c8d9e0f1a2b
# Cifra los secretos de Pronesoft (e-CF). NO lo cambies una vez guardadas
# credenciales, o los secretos cifrados dejarán de poder descifrarse.
ECF_SECRET_KEY=change_me_ecf_key_32_bytes_min_rota_esto

# --- PUBLIC URLs (FOR FRONTEND & CORS) ---
NEXT_PUBLIC_API_URL=https://master.automatostech.com
NEXT_PUBLIC_APP_URL=https://pos.automatostech.com
CORS_ORIGINS=https://pos.automatostech.com,https://master.automatostech.com

# --- ASISTENTE IA (modelo local en PC casera, vía Cloudflare Tunnel) ---
# URL del túnel que expone Ollama. El modelo debe coincidir con `ollama list`.
AI_BASE_URL=https://ai.automatostech.com
AI_MODEL=qwen2.5:7b-instruct-q4_K_M
# Modelo de visión para leer facturas (foto). Debe estar en `ollama list` de la PC.
# minicpm-v (~5.5GB) cabe bien en 8GB VRAM y es fuerte en OCR de documentos.
AI_VISION_MODEL=minicpm-v
# Service Token de Cloudflare Access (pega aquí los valores que guardaste).
AI_ACCESS_CLIENT_ID=pega_aqui_el_client_id
AI_ACCESS_CLIENT_SECRET=pega_aqui_el_client_secret

# --- DOCKER INTERNAL URLS ---
DATABASE_URL=postgresql://minimarket:AutomatosSecurePass2026!@minimarket_postgres_prod:5432/minimarket_os?schema=public
REDIS_URL=redis://:AutomatosRedisPass2026!@minimarket_redis_prod:6379
NODE_ENV=production
